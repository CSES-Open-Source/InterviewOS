# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/interviewos"

# Login sessions (run `npx auth secret` to generate one)
AUTH_SECRET=""

# LiveKit (video and audio)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""
